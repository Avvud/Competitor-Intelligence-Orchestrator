# === LLM keys ===
GROQ_API_KEY=your_groq_api_key_here

# === Smart tier (Groq cloud) ===
SMART_BASE_URL=https://api.groq.com/openai/v1
SMART_MODEL=llama-3.3-70b-versatile
FAST_CLOUD_MODEL=llama-3.1-8b-instant

# === Bulk tier (local Ollama) ===
BULK_BASE_URL=http://localhost:11434/v1
BULK_MODEL=gemma3:4b

# === Optional fallback (another provider) ===
# FALLBACK_BASE_URL=
# FALLBACK_API_KEY=
# FALLBACK_MODEL=

# === Database ===
# Leave blank to use default: data/competitor_intel.db
# DB_URL=sqlite:///data/competitor_intel.db
